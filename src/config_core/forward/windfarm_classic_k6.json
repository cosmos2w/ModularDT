{
  "schema_version": 1,
  "profile_name": "windfarm_classic_k6",
  "workflow": "forward",
  "model_family": "honf_forward",
  "case": {
    "id": "WindFarm",
    "config": "project://Case_WindFarm/configs/forward_velocity.json",
    "dataset_id": "wind_farm_volume_v1"
  },
  "model": {
    "core_honf": {
      "field_dim": 3,
      "spatial_dim": 3,
      "forward_architecture": "legacy_honf",
      "coordinate_scale": [50.0, 38.0, 6.25],
      "periodic_axes": [],
      "local_context_scale": 0.5,
      "module_radius": 0.5,
      "num_env_tokens_x": 16,
      "num_env_tokens_y": 8,
      "num_hyperedges": 6,
      "organizer_mode": "fixed_projection",
      "edge_capacity": 0,
      "initial_active_edges": 6,
      "minimum_active_edges": 1,
      "slot_refinement_steps": 2,
      "edge_selection_mode": "all",
      "module_assignment_normalizer": "softmax",
      "environment_assignment_normalizer": "softmax",
      "query_assignment_normalizer": "softmax",
      "environment_locality_mode": "none",
      "query_locality_mode": "none",
      "mechanism_state_mode": "residual_concat",
      "field_assembly_mode": "context_fusion",
      "routing_execution": "dense",
      "query_edge_limit": 0,
      "query_module_limit": 0,
      "pairwise_aggregation_mode": "fused_query_module",
      "pairwise_kernel_mode": "legacy_mlp",
      "query_module_retained_mass_floor": 1.0,
      "hidden_dim": 256,
      "dropout": 0.0,
      "use_layer_norm": true,
      "geometry_mode": "nonperiodic",
      "query_time_mode": "none",
      "decoder_mode": "enhanced_honf_pairwise",
      "use_hyper_value_context": true,
      "hyper_module_assignment_mode": "learned",
      "hyper_query_attention_mode": "learned",
      "hyper_attention_topk": 0,
      "hyper_attention_temperature": 1.0,
      "sparse_hyper_attention_detach_mask": true,
      "pairwise_kernel_hidden_dim": 256,
      "pairwise_kernel_num_layers": 4,
      "pairwise_kernel_gate_init": 0.1,
      "pairwise_kernel_use_fourier": true,
      "pairwise_kernel_fourier_frequencies": 4,
      "pairwise_kernel_include_module_token": true,
      "pairwise_kernel_include_module_features": true,
      "pairwise_kernel_normalize_by_edge_mass": true,
      "query_fourier_frequencies": 4,
      "boundary_feature_mode": "none",
      "position_fourier_frequencies": 4,
      "use_position_fourier_for_modules": true,
      "use_position_fourier_for_env": true,
      "use_hyper_mechanism_encoder": false,
      "mechanism_include_geometry": true,
      "mechanism_include_masses": true,
      "mechanism_hidden_dim": null,
      "use_hyper_geometry_bias": true,
      "hyper_geometry_bias_scale": 1.0,
      "use_A_me_auxiliary": true,
      "direct_residual_gate_init": 0.0,
      "output_mean_residual_split": false
