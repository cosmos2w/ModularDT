{
  "schema_version": 1,
  "profile_name": "windfarm_dense_pairwise",
  "workflow": "forward",
  "model_family": "honf_forward",
  "case": {
    "id": "WindFarm",
    "config": "project://Case_WindFarm/configs/forward_velocity.json",
    "dataset_id": "wind_farm_volume_v1"
  },
  "model": {
    "core_honf": {
      "forward_architecture": "dense_pairwise_field",
      "interface_model": {
        "message_hidden_dim": 128,
        "attention_heads": 4,
        "coarse_latent_count": 8,
        "coarse_blocks": 1,
        "main_latent_count": 16,
        "main_latent_blocks": 2,
        "local_radius_factor": 2.5,
        "relative_fourier_frequencies": 4,
        "receiver_chunk_size": 128,
        "activation_checkpointing": true
      },
      "field_dim": 3,
      "spatial_dim": 3,
      "coordinate_scale": [50.0, 38.0, 6.25],
      "periodic_axes": [],
      "local_context_scale": 0.5,
      "num_env_tokens_x": 16,
      "num_env_tokens_y": 8,
      "hidden_dim": 256,
      "dropout": 0.0,
      "use_layer_norm": true,
      "geometry_mode": "nonperiodic",
      "query_time_mode": "none",
      "query_fourier_frequencies": 4,
      "boundary_feature_mode": "none",
      "position_fourier_frequencies": 4,
      "use_position_fourier_for_modules": true,
      "use_position_fourier_for_env": true,
      "module_radius": 0.5
    }
  },
  "training": {
    "seed": 0,
    "device": "cuda:0",
    "epochs": 500,
    "learning_rate": 0.0003,
    "organizer_learning_rate": null,
    "weight_decay": 0.00001,
    "amp": false,
    "gradient_clip_norm": 1.0,
    "plot_every_epochs": 50,
    "max_train_batches_per_epoch": null,
    "max_val_batches": null
  },
  "checkpointing": {
    "save_best": true,
    "save_best_field_mse": true,
    "save_best_temperature_mse": false,
    "save_best_predicted": false,
    "save_latest": true,
    "save_latest_every_epochs": 10,
    "save_epoch_milestones": [10, 50, 100, 250, 500, 1000, 2500, 5000]
  },
  "run": {
    "id": "2101",
    "name": "windfarm_dense_velocity",
    "output_root": "project://Trained_Results"
  },
  "_note": "Dense PairwiseField architecture adapted to native 3-D geometry; no thermal modules or weights."
}
