{
  "schema_version": 1,
  "profile_name": "three_term_full_access_honf_context",
  "workflow": "forward",
  "model_family": "honf_forward",
  "case": {
    "id": "ThermalChannel",
    "config": "project://Case_ThermalChannel/configs/case_default.json",
    "dataset_id": "thermal_channel_global_v1"
  },
  "model": {
    "core_honf": {
      "forward_architecture": "three_term_full_access_honf",
      "interface_model": {
        "message_hidden_dim": 128,
        "attention_heads": 4,
        "relative_fourier_frequencies": 4,
        "receiver_chunk_size": 128,
        "activation_checkpointing": true
      },
      "field_dim": "auto",
      "domain_length_x": "auto",
      "domain_length_y": "auto",
      "module_radius": "auto",
      "coordinate_scale": [12.0, 6.0],
      "periodic_axes": [],
      "num_env_tokens_x": 24,
      "num_env_tokens_y": 8,
      "hidden_dim": 256,
      "dropout": 0.0,
      "use_layer_norm": true,
      "geometry_mode": "nonperiodic",
      "query_time_mode": "none",
      "query_fourier_frequencies": 4,
      "boundary_feature_mode": "none",
      "position_fourier_frequencies": 4,
      "use_position_fourier_for_modules": true,
      "use_position_fourier_for_env": true
    }
  },
  "training": {
    "seed": 0,
    "device": "cuda:0",
    "epochs": 500,
    "learning_rate": 0.0003,
    "organizer_learning_rate": null,
    "weight_decay": 0.00001,
    "amp": false,
    "gradient_clip_norm": 1.0,
    "plot_every_epochs": 25,
    "max_train_batches_per_epoch": null,
    "max_val_batches": null
  },
  "checkpointing": {
    "save_best": true,
    "save_best_field_mse": true,
    "save_best_temperature_mse": true,
    "save_best_predicted": true,
    "save_latest": true,
    "save_latest_every_epochs": 5,
    "save_epoch_milestones": [10, 25, 50, 100, 250, 500]
  },
  "run": {
    "name": "three_term_full_access_response_control",
    "output_root": "project://Trained_Results"
  },
  "_note": "Opt-in full-access three-term refit control. Run with CUDA_VISIBLE_DEVICES=2 so logical cuda:0 maps to physical GPU 2. It has no fixed organizer or direct group field shortcut. Its 500-epoch limit is a ceiling; the decision-aware study also enforces 20000 real optimizer updates and its GPU-hour budget. Compatible Run-1508 fine tensors may initialize it, but removing source-conditioned controls is a refit, not an exact checkpoint conversion."
}
