      "mixed_teacher_ratio_start": 0.0,
      "mixed_teacher_ratio_end": 0.0
    },
    "max_train_batches_per_epoch": null,
    "max_val_batches": null
  },
  "checkpointing": {
    "save_best": true,
    "save_best_field_mse": true,
    "save_best_temperature_mse": true,
    "save_best_predicted": true,
    "save_latest": true,
    "save_latest_every_epochs": 10,
    "save_epoch_milestones": [
      50,
      150,
      500
    ]
