{
  "schema_version": 1,
  "profile_name": "source_conditioned_pairwise_honf_context",
  "workflow": "forward",
  "model_family": "honf_forward",
  "case": {
    "id": "ThermalChannel",
    "config": "project://Case_ThermalChannel/configs/case_default.json",
    "dataset_id": "thermal_channel_global_v1"
  },
  "model": {
    "core_honf": {
      "forward_architecture": "source_conditioned_pairwise_honf",
      "interface_model": {
        "message_hidden_dim": 128,
        "attention_heads": 4,
        "relative_fourier_frequencies": 4,
        "receiver_chunk_size": 128,
        "activation_checkpointing": true,
        "group_count": 12,
        "source_normalizer": "entmax15",
        "module_temperature": 1.0,
        "environment_temperature": 1.0,
        "group_control_dim": 16,
        "environment_refinement_normalizer": "sparsemax"
