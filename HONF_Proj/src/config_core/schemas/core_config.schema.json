{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honf.example/schemas/core-config-v1.json",
  "title": "HONF core launch profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_name", "workflow", "model_family", "case", "model", "training", "checkpointing", "run"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_name": {"type": "string", "minLength": 1},
    "workflow": {"enum": ["forward", "local_module"]},
    "model_family": {"type": "string", "minLength": 1},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config", "dataset_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "config": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "local_module_id": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core_honf": {"$ref": "#/$defs/core_honf"}
      }
    },
    "training": {"$ref": "#/$defs/training"},
    "checkpointing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "save_best": {"type": "boolean"},
        "save_best_field_mse": {"type": "boolean"},
        "save_best_temperature_mse": {"type": "boolean"},
        "save_best_predicted": {"type": "boolean"},
        "save_latest": {"type": "boolean"},
        "save_latest_every_epochs": {"type": "integer", "minimum": 1},
        "save_epoch_milestones": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "output_root"],
      "properties": {
        "id": {"type": ["string", "integer"], "pattern": "^[0-9]+$"},
        "name": {"type": "string", "minLength": 1},
        "output_root": {"type": "string", "minLength": 1}
      }
    },
    "_note": {}
  },
  "$defs": {
    "positive_or_auto": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {"const": "auto"}
      ]
    },
    "integer_or_auto": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"const": "auto"}
      ]
    },
    "core_honf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_dim": {"$ref": "#/$defs/integer_or_auto"},
        "domain_length_x": {"$ref": "#/$defs/positive_or_auto"},
        "domain_length_y": {"$ref": "#/$defs/positive_or_auto"},
        "module_radius": {"$ref": "#/$defs/positive_or_auto"},
        "coordinate_scale": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "periodic_axes": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 1}
        },
        "local_context_scale": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "num_env_tokens_x": {"type": "integer", "minimum": 1},
        "num_env_tokens_y": {"type": "integer", "minimum": 1},
        "num_hyperedges": {"type": "integer", "minimum": 1},
        "organizer_mode": {"enum": ["fixed_projection", "exchangeable_slots"]},
        "edge_capacity": {"type": "integer", "minimum": 0},
        "initial_active_edges": {"type": "integer", "minimum": 1},
        "minimum_active_edges": {"type": "integer", "minimum": 1},
        "slot_refinement_steps": {"type": "integer", "minimum": 1},
        "slot_code_mode": {"enum": ["sinusoidal", "low_discrepancy"]},
        "edge_selection_mode": {"enum": ["all", "quality_coverage"]},
        "selection_warmup_epochs": {"type": "integer", "minimum": 0},
        "selection_coverage_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "selection_token_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "selection_maximum_redundancy": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_module_mass_fraction_floor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "candidate_environment_mass_fraction_floor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "module_assignment_normalizer": {"enum": ["softmax", "entmax15"]},
        "environment_assignment_normalizer": {"enum": ["softmax", "entmax15"]},
        "query_assignment_normalizer": {"enum": ["softmax", "entmax15"]},
        "entmax_alpha": {"type": "number", "exclusiveMinimum": 1, "maximum": 2},
        "environment_locality_mode": {"enum": ["none", "compact_kernel", "bounded_gaussian", "gaussian_bounded"]},
        "environment_locality_strength": {"type": "number", "minimum": 0},
        "query_locality_mode": {"enum": ["none", "compact_kernel", "bounded_gaussian", "gaussian_bounded", "inherit_environment"]},
        "query_locality_strength": {"type": ["number", "null"], "minimum": 0},
        "locality_radius_cap": {"type": "number", "exclusiveMinimum": 0},
        "minimum_region_scale": {"type": "number", "exclusiveMinimum": 0},
        "mechanism_state_mode": {"enum": ["residual_concat", "descriptor_first"]},
        "mechanism_latent_residual_scale": {"type": "number", "minimum": 0, "maximum": 1},
        "field_assembly_mode": {"enum": ["context_fusion", "edge_additive"]},
        "additive_background_mode": {"enum": ["dense_query_attention", "global_pooled_attention"]},
        "additive_edge_gate_init": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "additive_output_init_std": {"type": "number", "exclusiveMinimum": 0},
        "routing_execution": {"enum": ["dense", "gathered"]},
        "query_edge_limit": {"type": "integer", "minimum": 0},
        "query_module_limit": {"type": "integer", "minimum": 0},
        "topology_signature_enabled": {"type": "boolean"},
        "hidden_dim": {"type": "integer", "minimum": 1},
        "dropout": {"type": "number", "minimum": 0, "maximum": 1},
        "use_layer_norm": {"type": "boolean"},
        "geometry_mode": {"enum": ["nonperiodic", "periodic"]},
        "query_time_mode": {"enum": ["none", "phase", "physical_time"]},
        "decoder_mode": {"enum": ["hyper_only", "hyper_plus_global", "hyper_plus_direct_residual", "hyper_plus_near_module", "hyper_plus_global_near", "hyper_plus_global_direct", "hyper_plus_near_direct", "no_hyper_global_near", "no_hyper_current_like_direct", "current_like", "enhanced_honf_pairwise", "enhanced_honf_pairwise_only"]},
        "use_hyper_value_context": {"type": "boolean"},
        "query_fourier_frequencies": {"type": "integer", "minimum": 0},
        "boundary_feature_mode": {"enum": ["none", "rectangular", "channel"]},
        "position_fourier_frequencies": {"type": "integer", "minimum": 0},
        "use_position_fourier_for_modules": {"type": "boolean"},
        "use_position_fourier_for_env": {"type": "boolean"},
        "use_hyper_mechanism_encoder": {"type": "boolean"},
        "mechanism_include_geometry": {"type": "boolean"},
        "mechanism_include_masses": {"type": "boolean"},
        "mechanism_hidden_dim": {"type": ["integer", "null"], "minimum": 1},
        "hyper_module_assignment_mode": {"enum": ["learned", "uniform"]},
        "hyper_query_attention_mode": {"enum": ["learned", "uniform"]},
        "hyper_attention_topk": {"type": "integer", "minimum": 0},
        "hyper_attention_temperature": {"type": "number", "exclusiveMinimum": 0},
        "sparse_hyper_attention_detach_mask": {"type": "boolean"},
        "pairwise_kernel_hidden_dim": {"type": ["integer", "null"], "minimum": 1},
        "pairwise_kernel_num_layers": {"type": "integer", "minimum": 1},
        "pairwise_kernel_gate_init": {"type": "number", "minimum": 0, "maximum": 1},
        "pairwise_kernel_use_fourier": {"type": "boolean"},
        "pairwise_kernel_fourier_frequencies": {"type": "integer", "minimum": 0},
        "pairwise_kernel_include_module_token": {"type": "boolean"},
        "pairwise_kernel_include_module_features": {"type": "boolean"},
        "pairwise_kernel_normalize_by_edge_mass": {"type": "boolean"},
        "use_hyper_geometry_bias": {"type": "boolean"},
        "hyper_geometry_bias_scale": {"type": "number"},
        "direct_residual_gate_init": {"type": "number", "minimum": 0, "maximum": 1},
        "use_A_me_auxiliary": {"type": "boolean"},
        "output_mean_residual_split": {"type": "boolean"}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "epochs", "learning_rate"],
      "properties": {
        "seed": {"type": "integer"},
        "device": {"type": ["string", "null"]},
        "epochs": {"type": "integer", "minimum": 1},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "organizer_learning_rate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0},
        "amp": {"type": "boolean"},
        "gradient_clip_norm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "plot_every_epochs": {"type": "integer", "minimum": 1},
        "max_train_batches_per_epoch": {"type": ["integer", "null"], "minimum": 1},
        "max_val_batches": {"type": ["integer", "null"], "minimum": 1},
        "init_checkpoint_path": {"type": ["string", "null"]},
        "port_curriculum": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule": {"type": "string"},
            "mode": {"enum": ["teacher", "predicted", "mixed"]},
            "mixed_teacher_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "teacher_epochs": {"type": "integer", "minimum": 0},
            "predicted_after_epoch": {"type": "integer", "minimum": 0},
            "mixed_teacher_ratio_start": {"type": "number", "minimum": 0, "maximum": 1},
            "mixed_teacher_ratio_end": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
