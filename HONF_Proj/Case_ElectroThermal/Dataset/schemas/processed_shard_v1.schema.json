{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HET-MF processed HDF5 shard metadata v1",
  "type": "object",
  "required": ["shard_sha256", "accepted", "grid_n", "units", "kind", "field_order", "state_ids", "source_sha256"],
  "properties": {"shard_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "accepted": {"const": true}, "grid_n": {"type": "integer", "minimum": 2}, "units": {"const": "dimensionless"}, "kind": {"const": "processed"}, "field_order": {"const": "potential,jx_cell,jy_cell,temperature_rise,q_total"}, "state_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}}, "source_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
}
