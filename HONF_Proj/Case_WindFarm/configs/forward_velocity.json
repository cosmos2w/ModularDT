{
  "schema_version": 1,
  "profile_name": "windfarm_forward_velocity",
  "case_id": "WindFarm",
  "plugin": "windfarm.plugin:create_plugin",
  "dataset": {
    "manifest": "project://Case_WindFarm/Dataset/dataset_manifest.json",
    "locations": "project://Case_WindFarm/Dataset/dataset_locations.local.json",
    "compact_dataset_id": "wind_farm_tensor_v1",
    "volume_dataset_id": "wind_farm_volume_v1",
    "derived_view": "project://Case_WindFarm/Dataset/derived/forward_velocity_v1",
    "split_indices": "project://Case_WindFarm/Dataset/derived/forward_velocity_v1/split_indices.npz",
    "normalization": "project://Case_WindFarm/Dataset/derived/forward_velocity_v1/normalization.json",
    "sampling_metadata": "project://Case_WindFarm/Dataset/derived/forward_velocity_v1/sampling_metadata.json",
    "train_split": "train",
    "validation_split": "validation",
    "test_split": "test",
    "group_key": "layout_index",
    "batch_size": 8,
    "val_batch_size": 8,
    "num_workers": 0,
    "dynamic_module_padding": true,
    "max_modules_per_batch": 30,
    "q_train": 1024,
    "q_volume": 768,
    "q_band": 256,
    "env_token_shape": [16, 8, 4],
    "validation_volume_queries": 8192,
    "validation_band_queries": 2048,
    "target_channels": ["Ux", "Uy", "Uz"],
    "sample_seed": 42,
    "memory_map_volume": true,
    "require_complete_volume_runs": true,
    "allow_npz_metadata_fallback": true
  },
  "model": {},
  "loss": {
    "field_mse_weight": 1.0,
    "channel_weights": [1.0, 1.0, 1.0],
    "volume_loss_weight": 0.75,
    "band_loss_weight": 0.25,
    "volume_sampling_fraction": 0.75,
    "band_sampling_fraction": 0.25
  },
  "evaluation": {
    "split": "validation",
    "checkpoint": "best_by_field_mse",
    "query_batch_size": 1024,
    "validation_volume_queries": 32768,
    "validation_band_queries": 8192,
    "test_volume_queries": 32768,
    "test_band_queries": 8192,
    "save_case_metrics": true
  },
  "_note": "Field-only native-volume WindFarm adapter. Thermal local modules and solved-field inputs are intentionally absent."
}
